{ inputs, lib, vars, ... }:

let
  generated = import ./generated.nix;
  manual = import ./manual.nix { inherit lib vars; };
in
{
  imports = [ inputs.noctalia.homeModules.default ];
  programs.noctalia = {
    enable = true;
    # Imports the manual and automatically generated configs
    # generated.nix is automatically generated by the Noctalia plugin
    # The manual config file has higher priority than the automatically generated one
    settings = lib.recursiveUpdate generated manual;
  };
}
